{
  "format": 1,
  "module": "revisions",
  "notes": [
    "Run steps in order on an article that starts with no history and no reviewed_at. Section 5.",
    "save appends {at, author, content} and sets last_editor = author + at. keep sets reviewed_at to the newest revision at.",
    "undo appends the baseline content as {kind:\"user\"} with reason \"Undo agent edits\" at the given time and sets reviewed_at to it; with no baseline the step expects {error:\"no_baseline\"} and changes nothing.",
    "after each step, expect count (history length), latest_content, unseen and baseline_content (null when there is no baseline)."
  ],
  "cases": [
    {
      "name": "undo an agent edit",
      "fn": "revisionScript",
      "input": [
        {
          "op": "save",
          "at": "2026-10-01T00:01:00.000Z",
          "author": {
            "kind": "user",
            "device": "desktop"
          },
          "content": "c1"
        },
        {
          "op": "save",
          "at": "2026-10-01T00:02:00.000Z",
          "author": {
            "kind": "agent",
            "name": "Claude Code"
          },
          "content": "c2"
        },
        {
          "op": "undo",
          "at": "2026-10-01T00:03:00.000Z"
        }
      ],
      "expect": [
        {
          "count": 1,
          "latest_content": "c1",
          "unseen": false,
          "baseline_content": "c1"
        },
        {
          "count": 2,
          "latest_content": "c2",
          "unseen": true,
          "baseline_content": "c1"
        },
        {
          "count": 3,
          "latest_content": "c1",
          "unseen": false,
          "baseline_content": "c1"
        }
      ]
    },
    {
      "name": "agent-created article has no baseline",
      "fn": "revisionScript",
      "input": [
        {
          "op": "save",
          "at": "2026-10-01T00:01:00.000Z",
          "author": {
            "kind": "agent",
            "name": "Claude Code"
          },
          "content": "c1"
        },
        {
          "op": "undo",
          "at": "2026-10-01T00:02:00.000Z"
        }
      ],
      "expect": [
        {
          "count": 1,
          "latest_content": "c1",
          "unseen": true,
          "baseline_content": null
        },
        {
          "error": "no_baseline"
        }
      ]
    },
